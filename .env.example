# Public URL where Voximplant can fetch generated WAV files.
# Use HTTPS in production or a tunnel such as ngrok/cloudflared during local testing.
PUBLIC_BASE_URL=https://your-public-backend.example

GENERATED_AUDIO_DIR=generated_audio

# Piper CLI configuration. PIPER_MODEL can be a local .onnx path or a voice name
# supported by the installed Piper package.
PIPER_EXECUTABLE=piper
PIPER_MODEL=./models/ru_RU-irina-medium.onnx
# PIPER_CONFIG=./models/ru_RU-irina-medium.onnx.json
# PIPER_SPEAKER=0
PIPER_TIMEOUT_SECONDS=60

# Voximplant Management API credentials and routing rule.
VOXIMPLANT_ACCOUNT_ID=1234567
VOXIMPLANT_API_KEY=replace_me
VOXIMPLANT_RULE_ID=123456
VOXIMPLANT_API_BASE_URL=https://api.voximplant.com/platform_api
VOXIMPLANT_CUSTOM_DATA_MAX_BYTES=200
REQUEST_TIMEOUT_SECONDS=20

